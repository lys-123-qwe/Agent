spring.application.name=youkeda_project
spring.main.web-application-type=none

# 天气 API（和风天气）
weather.api.key=your_weather_api_key
weather.api.url=https://na3h2taynf.re.qweatherapi.com/v7/weather/now

# AI 模型 API（DeepSeek）
ai.api.key=your_deepseek_api_key
ai.api.url=https://api.deepseek.com/chat/completions

# 图像生成 API（通义万相）
image.api.key=your_dashscope_api_key
image.api.url=https://dashscope.aliyuncs.com

# 图像识别 API（通义千问 VL，复用 image.api.key）
vision.api.url=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# 新闻搜索 API（博查搜索）
news.api.key=your_bocha_api_key

# 语音识别 API（Paraformer，复用 image.api.key，有默认值可不填）
# voice.api.url=https://dashscope.aliyuncs.com/api/v1/services/audio/asr/transcriptions
# voice.api.model=paraformer-v2
