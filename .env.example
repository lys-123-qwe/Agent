# ============================================================
# Claw 助手 配置模板 — 复制本文件为 .env 后填入自己的密钥
#   cp .env.example .env     (Windows: copy .env.example .env)
# 然后: docker compose up -d
# 说明: 不填密钥也能启动, 但对应功能不可用 (AI 对话必须填 AI_API_KEY)
# ============================================================

# DeepSeek 大模型 (AI 对话核心, 必填)
AI_API_KEY=

# 和风天气 (查天气)
WEATHER_API_KEY=

# 阿里云 DashScope (生图/识图/语音识别/语音合成, 一个 key 通用)
IMAGE_API_KEY=

# 博查搜索 (搜新闻/资讯)
BOCHA_API_KEY=

# 聚合数据 (手机号码归属地)
PHONE_API_KEY=

# 汇率转换
EXCHANGE_API_KEY=

# 聚合数据 (星座查询)
CONSTELLATION_QUERY_API_KEY=

# 聚合数据 (星座运势)
CONSTELLATION_HOROSCOPE_API_KEY=

# 天聚数行 (新闻)
NEWS_SDK_API_KEY=

# 阿里云市场 (快递查询, 可选)
EXPRESS_API_APPCODE=
